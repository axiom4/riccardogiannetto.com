{
  "name": "rg-web-new",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/generate-sri.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-generator-cli generate  -p supportsES6=true,withInterfaces=true,useSingleRequestParameter=true -i http://127.0.0.1:8000/openapi -g typescript-angular -o src/app/modules/core/api/v1",
    "lint": "eslint ."
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@types/leaflet": "^1.9.22",
    "@types/prismjs": "^1.26.6",
    "dompurify": "^3.4.15",
    "leaflet": "^1.9.4",
    "marked": "^18.0.11",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "node-html-parser": "^9.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "@openapitools/openapi-generator-cli@2.41.0": true
  }
}
